@using System.Text.Json;
@model IEnumerable<WorkoutTracker.Models.Workout>

@{
    ViewData["Title"] = "Index";
}

<h1>Workout Tracker and Planner</h1>

<p>
    <a asp-controller="Workouts" asp-action="Create">Create a New Workout</a>
</p>
<p>
    <a asp-controller="Home" asp-action="Logout">Logout</a>
</p>
<div style="margin-bottom: 15px;">
    <a asp-action="Index" asp-route-filter="week" 
    class="btn @(ViewBag.CurrentFilter == "week"? "btn-primary": "btn-outline-primary")">This Week</a>

    <a asp-action="Index" asp-route-filter="all"
    class="btn @(ViewBag.CurrentFilter == "all"? "btn-primary": "btn-outline-primary")">All Time</a>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Date)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DurationMinutes)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Date)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DurationMinutes)
            </td>
            <td>
                <a asp-controller="Workouts" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-controller="Workouts" asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-controller="Workouts" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

<h2>Fitness Analytics</h2>

<h3>Volume Progress</h3>
<canvas id="volumeChart"></canvas>

<h3>Workout Duration</h3>
<canvas id="durationChart"></canvas>

<h3>Personal Records</h3>
<ul>
    @if (ViewBag.PersonalRecords != null)
    {
        foreach (var personalRecords in ViewBag.PersonalRecords)
        {
            <li>@personalRecords.Exercise - @personalRecords.MaxWeight lbs</li>
        }
    }
</ul>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const volumeLabels = @Html.Raw(Json.Serialize(ViewBag.Dates ?? new List<string>()));
    const volumeData = @Html.Raw(Json.Serialize(ViewBag.Volume ?? new List<double>()));

    new Chart(document.getElementById('volumeChart'), {
    type: 'line',
    data: {
    labels: volumeLabels,
    datasets: [{
    label: 'Total Volume',
    data: volumeData,
    borderWidth: 2
    }]
    }
    });

    const durationLabels = @Html.Raw(Json.Serialize(ViewBag.DurationDates ?? new List<string>()));
    const durationData = @Html.Raw(Json.Serialize(ViewBag.Duration ?? new List<double>()));

    new Chart(document.getElementById('durationChart'), {
    type: 'bar',
    data: {
    labels: durationLabels,
    datasets: [{
    label: 'Minutes',
    data: durationData
    }]
    }
    });
</script>
